/// Dimensao de ano (snowflake de DIM_CALENDARIO). 1 linha = 1 ano observado no universo.
table DIM_ANO
	lineageTag: f40943ca-1824-4bf2-8d11-187e389bfaac

	/// Chave da dimensao.
	column ano
		dataType: int64
		formatString: 0
		lineageTag: 2b84c56f-04fa-4f5f-8349-3c0409e92991
		summarizeBy: none
		sourceColumn: ano

	/// Calculado a partir dos meses distintos observados por ano (04_universo.py R9), nao fixo.
	column ano_parcial
		dataType: boolean
		lineageTag: 9aa67f88-cf09-4bc2-ae96-6cd9c3017315
		summarizeBy: none
		sourceColumn: ano_parcial

	/// Rotulo do indice de volume YTD homologo (REGIMES_TEMPORAIS, regras.py) -- nao e classificacao epidemiologica.
	column regime_temporal
		dataType: string
		lineageTag: 80edd4e9-e2ff-46f6-b027-05a6d8378860
		summarizeBy: none
		sourceColumn: regime_temporal

	partition DIM_ANO = m
		mode: import
		source =
				let
				    Origem = Parquet.Document(File.Contents(pPowerBIDataRoot & "\DIM_ANO.parquet")),
				    #"Tipos Alterados" = Table.TransformColumnTypes(Origem, {{"ano", Int64.Type}, {"ano_parcial", type logical}, {"regime_temporal", type text}})
				in
				    #"Tipos Alterados"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation


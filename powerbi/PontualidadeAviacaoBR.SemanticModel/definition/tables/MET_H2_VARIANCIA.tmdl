	partition MET_H2_VARIANCIA = m
		mode: import
		source =
				let
				    Origem = Parquet.Document(File.Contents(pPowerBIDataRoot & "\MET_H2_VARIANCIA.parquet")),
				    #"Tipos Alterados" = Table.TransformColumnTypes(Origem, {{"escopo", type text}, {"var_entre_operadoras_pp2", type number}, {"var_entre_aeroportos_pp2", type number}, {"razao", type number}, {"celulas_comparaveis", Int64.Type}, {"aeroportos_comparaveis", Int64.Type}, {"grupos_comparaveis", Int64.Type}, {"data_calculo", type datetime}})
				in

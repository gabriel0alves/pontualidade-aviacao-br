/// Referencia pre-agregada da decomposicao de variancia de H2 (aeroporto vs operadora). Tabela DESCONECTADA -- 3 escopos fixos.
table MET_H2_VARIANCIA
	lineageTag: c8cb1ae3-1286-44d3-b66a-ac70cce62a90

	/// H2: aeroporto vs operadora. >1 compatível com H2, <1 refuta. Sem reconciliação DAX dinâmica -- lógica só em decompor_variancia() (§11.3).
	measure 'Razão de Variância H2 -- Todas as Operadoras' =
			VAR _linhas =
			    CALCULATETABLE(
			        MET_H2_VARIANCIA,
			        MET_H2_VARIANCIA[escopo] = "todas_operadoras"
			    )
			VAR _n = COUNTROWS(_linhas)
			RETURN
			    IF(_n = 1, MAXX(_linhas, MET_H2_VARIANCIA[razao]))
		formatString: 0.0000
		displayFolder: Concentração
		lineageTag: ada8130e-e838-4a57-84d2-2be6992cad8c

	/// H2: aeroporto vs operadora. >1 compatível com H2, <1 refuta. Sem reconciliação DAX dinâmica -- lógica só em decompor_variancia() (§11.3).
	measure 'Razão de Variância H2 -- Azul/LATAM/GOL (Operadora)' =
			VAR _linhas =
			    CALCULATETABLE(
			        MET_H2_VARIANCIA,
			        MET_H2_VARIANCIA[escopo] = "azul_latam_gol_operadora"
			    )
			VAR _n = COUNTROWS(_linhas)
			RETURN
			    IF(_n = 1, MAXX(_linhas, MET_H2_VARIANCIA[razao]))
		formatString: 0.0000
		displayFolder: Concentração
		lineageTag: 1e381e7e-c30d-4f0d-b5b6-dc716aeeb063

	/// H2: aeroporto vs operadora. >1 compatível com H2, <1 refuta. Sem reconciliação DAX dinâmica -- lógica só em decompor_variancia() (§11.3).
	measure 'Razão de Variância H2 -- Azul/LATAM/GOL (Grupo Econômico)' =
			VAR _linhas =
			    CALCULATETABLE(
			        MET_H2_VARIANCIA,
			        MET_H2_VARIANCIA[escopo] = "azul_latam_gol_grupo"
			    )
			VAR _n = COUNTROWS(_linhas)
			RETURN
			    IF(_n = 1, MAXX(_linhas, MET_H2_VARIANCIA[razao]))
		formatString: 0.0000
		displayFolder: Concentração
		lineageTag: 78cd5066-f402-49fc-993e-937cd09b0fb4


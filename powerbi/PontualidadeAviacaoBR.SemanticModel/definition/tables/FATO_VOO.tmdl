/// Fato de grao fino: 1 linha = 1 etapa de voo do universo analitico completo (nao filtrado a atraso_valido).
table FATO_VOO
	lineageTag: ff946855-77ff-4f74-9872-7c6b525e7b9d

	/// REALIZADO + CANCELADO. Denominador de cobertura e de cancelamento (todos os segmentos).
	measure 'Voos Programados' =
			CALCULATE(
			    COUNTROWS(FATO_VOO),
			    DIM_SITUACAO_VOO[situacao_voo] IN {"REALIZADO", "CANCELADO"}
			)
		formatString: #,0
		displayFolder: Volume
		lineageTag: 0eb64b7e-13ef-457f-b09e-986aa601b914

	/// REMOVEFILTERS antes de reaplicar o escopo -- imune a slicer de segmento deixado na página (Decisão 2).
	measure 'Voos Programados -- Passageiros' =
			CALCULATE(
			    [Voos Programados],
			    REMOVEFILTERS(DIM_SEGMENTO),
			    DIM_SEGMENTO[entra_headline_kpi6] = TRUE()
			)
		formatString: #,0
		displayFolder: Volume
		lineageTag: f84dc64e-90e5-4ffb-9415-a2da02ac24ad

	/// Mesma regra de 'Voos Programados -- Passageiros', restrita a registros com data_partida_prevista preenchida (decisão A, Rodada 7A) -- equivalente a dropna(subset=["ano"]) do Python, comprovado empiricamente linha a linha contra data_partida_prevista.
	measure 'Voos Programados -- Passageiros (Com Período)' =
			CALCULATE(
			    [Voos Programados -- Passageiros],
			    KEEPFILTERS(FATO_VOO[data_partida_prevista] <> BLANK())
			)
		formatString: #,0
		displayFolder: Volume
		lineageTag: cd0f4f35-37f2-4db0-9265-4712f9855c92

	/// REMOVEFILTERS(DIM_SEGMENTO) explícito -- sensibilidade D3, todos os segmentos. Extraída como medida-base para reuso pela cobertura temporal, sem duplicar a regra.
	measure 'Voos Programados -- Todos os Segmentos' =
			CALCULATE(
			    [Voos Programados],
			    REMOVEFILTERS(DIM_SEGMENTO)
			)
		formatString: #,0
		displayFolder: Volume
		lineageTag: afef3c34-9739-4667-adb7-d775a20f2544

	/// Mesma regra de 'Voos Programados -- Todos os Segmentos', restrita a registros com data_partida_prevista preenchida (decisão A, Rodada 7A).
	measure 'Voos Programados -- Todos os Segmentos (Com Período)' =
			CALCULATE(
			    [Voos Programados -- Todos os Segmentos],
			    KEEPFILTERS(FATO_VOO[data_partida_prevista] <> BLANK())
			)
		formatString: #,0
		displayFolder: Volume
		lineageTag: 50e9f921-bee0-406c-b066-a3672763ca18

	/// Base de OTP15/KPI2/KPI3/KPI5/KPI9 -- R∩P∩Lp.
	measure 'Voos Válidos' =
			CALCULATE(
			    COUNTROWS(FATO_VOO),
			    FATO_VOO[atraso_valido] = TRUE()
			)
		formatString: #,0
		displayFolder: Volume
		lineageTag: ac9d635e-3db2-4fb3-852b-95e6ed7f0b58

	/// Mede qualidade de dado (voos válidos / programados), não desempenho operacional -- rótulo diferenciado obrigatório (§9).
	measure 'Cobertura dos Dados %' = DIVIDE([Voos Válidos], [Voos Programados])
		formatString: 0.00%
		displayFolder: Volume
		lineageTag: 1d55bc70-b45d-4ce2-9119-57d3d91b3cf8

	/// KPI1. Padrão internacional OTP15 (LIMIAR_PONTUALIDADE=15min).
	measure 'OTP15 %' =
			DIVIDE(
			    CALCULATE(
			        COUNTROWS(FATO_VOO),
			        FATO_VOO[atraso_valido] = TRUE(),
			        FATO_VOO[atrasado_15] = FALSE()
			    ),
			    [Voos Válidos]
			)
		formatString: 0.00%
		displayFolder: Pontualidade
		lineageTag: 04a09a1a-6bb8-4e31-9c04-ae77548749c8

	/// KPI2.
	measure 'Taxa Atraso 30min %' =
			DIVIDE(
			    CALCULATE(
			        COUNTROWS(FATO_VOO),
			        FATO_VOO[atraso_valido] = TRUE(),
			        FATO_VOO[atrasado_30] = TRUE()
			    ),
			    [Voos Válidos]
			)
		formatString: 0.00%
		displayFolder: Atraso severo
		lineageTag: f8902a33-88ad-413f-a98e-e2ab06914bd5

	/// KPI2.
	measure 'Taxa Atraso 60min %' =
			DIVIDE(
			    CALCULATE(
			        COUNTROWS(FATO_VOO),
			        FATO_VOO[atraso_valido] = TRUE(),
			        FATO_VOO[atrasado_60] = TRUE()
			    ),
			    [Voos Válidos]
			)
		formatString: 0.00%
		displayFolder: Atraso severo
		lineageTag: 3bb3467b-1916-41fe-a42e-e26ffa61c77b

	/// KPI3. MEDIANX nativo -- funciona sob qualquer filtro, sem tabela pré-agregada.
	measure 'Mediana Atraso Partida (min)' =
			MEDIANX(
			    FILTER(FATO_VOO, FATO_VOO[atraso_valido] = TRUE()),
			    FATO_VOO[atraso_partida_min]
			)
		formatString: #,0.00
		displayFolder: Impacto
		lineageTag: 488566cd-d8d3-4a06-a83c-e6cc41c445fd

	/// KPI5. Só atraso positivo entra (Métrica B, ver eda_bloco_d.md D.2) -- minutos negativos não são 'crédito'.
	measure 'Minutos Acumulados de Atraso' =
			CALCULATE(
			    SUM(FATO_VOO[atraso_partida_min]),
			    FATO_VOO[atraso_valido] = TRUE(),
			    FATO_VOO[atraso_partida_min] > 0
			)
		formatString: #,0
		displayFolder: Impacto
		lineageTag: ca241592-dbea-4b0e-a20a-56243b8a7d16

	/// KPI9, SECUNDÁRIO. A distribuição é assimétrica e de cauda pesada -- a média não descreve bem o fenômeno e não deve liderar o painel (ver eda_bloco_d.md D.8).
	measure 'Atraso Médio (min) [KPI9 -- secundário, nunca destaque]' =
			CALCULATE(
			    AVERAGE(FATO_VOO[atraso_partida_min]),
			    FATO_VOO[atraso_valido] = TRUE()
			)
		formatString: #,0.00
		displayFolder: Impacto
		lineageTag: bac203a3-c6a7-4b5d-963a-835ea1b179b2

	/// KPI6.
	measure Cancelamentos =
			CALCULATE(
			    COUNTROWS(FATO_VOO),
			    DIM_SITUACAO_VOO[situacao_voo] = "CANCELADO"
			)
		formatString: #,0
		displayFolder: Cancelamento
		lineageTag: 14eebfb7-fe8d-40de-b781-4069fce633d6

	/// Mesma disciplina de REMOVEFILTERS de 'Voos Programados -- Passageiros'.
	measure 'Cancelamentos -- Passageiros' =
			CALCULATE(
			    [Cancelamentos],
			    REMOVEFILTERS(DIM_SEGMENTO),
			    DIM_SEGMENTO[entra_headline_kpi6] = TRUE()
			)
		formatString: #,0
		displayFolder: Cancelamento
		lineageTag: eacd7148-bd9f-4599-9050-0e36bc0b1ebe

	/// Mesma regra de 'Cancelamentos -- Passageiros', restrita a registros com data_partida_prevista preenchida (decisão A, Rodada 7A).
	measure 'Cancelamentos -- Passageiros (Com Período)' =
			CALCULATE(
			    [Cancelamentos -- Passageiros],
			    KEEPFILTERS(FATO_VOO[data_partida_prevista] <> BLANK())
			)
		formatString: #,0
		displayFolder: Cancelamento
		lineageTag: f0775d21-b2a5-4ae6-9787-76bca41de4c3

	/// REMOVEFILTERS(DIM_SEGMENTO) explícito -- sensibilidade D3, todos os segmentos. Extraída como medida-base para reuso pela cobertura temporal, sem duplicar a regra.
	measure 'Cancelamentos -- Todos os Segmentos' =
			CALCULATE(
			    [Cancelamentos],
			    REMOVEFILTERS(DIM_SEGMENTO)
			)
		formatString: #,0
		displayFolder: Cancelamento
		lineageTag: 82dd78d9-73d9-4fcf-ba71-0d1f875cc933

	/// Mesma regra de 'Cancelamentos -- Todos os Segmentos', restrita a registros com data_partida_prevista preenchida (decisão A, Rodada 7A).
	measure 'Cancelamentos -- Todos os Segmentos (Com Período)' =
			CALCULATE(
			    [Cancelamentos -- Todos os Segmentos],
			    KEEPFILTERS(FATO_VOO[data_partida_prevista] <> BLANK())
			)
		formatString: #,0
		displayFolder: Cancelamento
		lineageTag: f1d385e1-bf3c-4496-a21d-e7e36641d3b7

	/// HEADLINE oficial do KPI6 (decisão D3) -- operações de passageiros com segmento validado, restritas a registros com data_partida_prevista preenchida (decisão A, Rodada 7A: elegibilidade temporal equivalente ao dropna(subset=["ano"]) do Python, aplicada dentro da medida -- nunca por filtro de página). Imune a slicer de segmento (Decisão 2).
	measure 'Taxa de Cancelamento -- Headline' =
			DIVIDE(
			    [Cancelamentos -- Passageiros (Com Período)],
			    [Voos Programados -- Passageiros (Com Período)]
			)
		formatString: 0.00%
		displayFolder: Cancelamento
		lineageTag: 039b328e-6974-4310-8d15-a153ac1733d9

	/// Sensibilidade OBRIGATÓRIA do D3 -- carga, táxi aéreo e não classificado inclusos. Nunca substitui o headline. Mesma elegibilidade temporal do headline (decisão A, Rodada 7A), aplicada dentro da medida.
	measure 'Taxa de Cancelamento -- Todos os Segmentos' =
			DIVIDE(
			    [Cancelamentos -- Todos os Segmentos (Com Período)],
			    [Voos Programados -- Todos os Segmentos (Com Período)]
			)
		formatString: 0.00%
		displayFolder: Cancelamento
		lineageTag: 4daa9c56-022c-4570-8693-27a72abbf5e2

	/// Cobertura temporal do KPI6 (decisão A, Rodada 7A) -- quantos voos programados de PASSAGEIROS ficam FORA do headline por não terem data_partida_prevista. Mesma regra de segmento do headline (entra_headline_kpi6 = TRUE()).
	measure 'Voos Programados sem Período -- Headline' = [Voos Programados -- Passageiros] - [Voos Programados -- Passageiros (Com Período)]
		formatString: #,0
		displayFolder: Cancelamento
		lineageTag: 8c16633a-fa71-4ec2-9015-5f222ed1b771

	/// Cobertura temporal do KPI6 (decisão A, Rodada 7A) -- quantos voos programados de TODOS os segmentos ficam FORA da visão de sensibilidade por não terem data_partida_prevista. Mesma regra de segmento (REMOVEFILTERS(DIM_SEGMENTO)) da visão todos-os-segmentos.
	measure 'Voos Programados sem Período -- Todos os Segmentos' = [Voos Programados -- Todos os Segmentos] - [Voos Programados -- Todos os Segmentos (Com Período)]
		formatString: #,0
		displayFolder: Cancelamento
		lineageTag: fc15836d-7500-4e4d-a49a-853d7162fd4d

	/// % dos voos programados de PASSAGEIROS que tinham data_partida_prevista preenchida, ou seja, que entraram no denominador do headline do KPI6 (decisão A, Rodada 7A) = programados com período / programados antes da exclusão temporal.
	measure 'Cobertura Temporal KPI6 -- Headline %' =
			DIVIDE(
			    [Voos Programados -- Passageiros (Com Período)],
			    [Voos Programados -- Passageiros]
			)
		formatString: 0.00%
		displayFolder: Cancelamento
		lineageTag: 4eb45981-119a-49c3-ac1d-29847983296f

	/// % dos voos programados de TODOS os segmentos que tinham data_partida_prevista preenchida, ou seja, que entraram no denominador da visão todos-os-segmentos do KPI6 (decisão A, Rodada 7A) = programados com período / programados antes da exclusão temporal.
	measure 'Cobertura Temporal KPI6 -- Todos os Segmentos %' =
			DIVIDE(
			    [Voos Programados -- Todos os Segmentos (Com Período)],
			    [Voos Programados -- Todos os Segmentos]
			)
		formatString: 0.00%
		displayFolder: Cancelamento
		lineageTag: 258b69c4-6a2b-47d1-abdb-3872a0387c27

	/// KPI7. Só sobre o subconjunto com elegibilidade completa (interseção dos 6 conjuntos, §13.3).
	measure 'Mediana Recuperação em Voo (KPI7)' =
			MEDIANX(
			    FILTER(FATO_VOO, FATO_VOO[atraso_chegada_valido] = TRUE()),
			    FATO_VOO[recuperacao_min]
			)
		formatString: #,0.00
		displayFolder: Recuperação
		lineageTag: d4af3e26-8bad-48ae-8717-061b709e91f2

	/// (1) Preserva os slicers do usuário; remove só o contexto local do visual sobre companhia.
	measure 'Participação nos Voos no Contexto Selecionado %' =
			DIVIDE(
			    [Voos Válidos],
			    CALCULATE([Voos Válidos], ALLSELECTED(DIM_COMPANHIA))
			)
		formatString: 0.00%
		displayFolder: Participação
		lineageTag: 0c5b4da9-0cbc-4f02-84e7-703b2e0554cc

	/// (1) Idem, sobre minutos.
	measure 'Participação nos Minutos de Atraso no Contexto Selecionado %' =
			DIVIDE(
			    [Minutos Acumulados de Atraso],
			    CALCULATE([Minutos Acumulados de Atraso], ALLSELECTED(DIM_COMPANHIA))
			)
		formatString: 0.00%
		displayFolder: Participação
		lineageTag: 4725074b-af58-4444-8c4f-b9fdf8a980f7

	/// (2) Remove só o filtro de companhia; mantém data/segmento/etc. Nunca ALL(FATO_VOO) inteiro (§10.1).
	measure 'Participação nos Voos no Total do Contexto %' =
			DIVIDE(
			    [Voos Válidos],
			    CALCULATE([Voos Válidos], REMOVEFILTERS(DIM_COMPANHIA))
			)
		formatString: 0.00%
		displayFolder: Participação
		lineageTag: 391454f8-fb41-4dec-8db5-7bbdc77956e4

	/// (2) Idem, sobre minutos.
	measure 'Participação nos Minutos de Atraso no Total do Contexto %' =
			DIVIDE(
			    [Minutos Acumulados de Atraso],
			    CALCULATE([Minutos Acumulados de Atraso], REMOVEFILTERS(DIM_COMPANHIA))
			)
		formatString: 0.00%
		displayFolder: Participação
		lineageTag: 98e3d736-1cf7-49dd-a6f4-4ace55a7287c

	/// Conjunto R do KPI7 (§13.3).
	measure 'R (Realizado)' =
			CALCULATE(
			    COUNTROWS(FATO_VOO),
			    DIM_SITUACAO_VOO[situacao_voo] = "REALIZADO"
			)
		formatString: #,0
		displayFolder: Qualidade dos dados
		lineageTag: 20d241c2-3ee0-4179-b8a2-41b52173e4de

	/// Conjunto P -- dinâmico nesta rodada (decisão 9).
	measure 'P (Partida Disponível)' =
			CALCULATE(
			    COUNTROWS(FATO_VOO),
			    FATO_VOO[partida_disponivel] = TRUE()
			)
		formatString: #,0
		displayFolder: Qualidade dos dados
		lineageTag: 4548dbaf-47ed-4406-953f-6d6425e2b2f3

	/// Conjunto Lp -- dinâmico nesta rodada (decisão 9).
	measure 'Lp (Atraso de Partida Dentro do Limite)' =
			CALCULATE(
			    COUNTROWS(FATO_VOO),
			    FATO_VOO[partida_disponivel] = TRUE(),
			    FATO_VOO[partida_dentro_do_limite] = TRUE()
			)
		formatString: #,0
		displayFolder: Qualidade dos dados
		lineageTag: 59abab87-fa10-48dc-b323-c0843aaefce0

	/// Reconcilia com 5.193.587 (regras.py, decisão D1).
	measure 'R∩P (Base do Conjunto 721)' =
			CALCULATE(
			    COUNTROWS(FATO_VOO),
			    DIM_SITUACAO_VOO[situacao_voo] = "REALIZADO",
			    FATO_VOO[partida_disponivel] = TRUE()
			)
		formatString: #,0
		displayFolder: Qualidade dos dados
		lineageTag: 3ce923fc-e5e9-43f6-b92b-efbc95dedc85

	/// Conjunto Dc.
	measure 'Dc (Chegada Disponível)' =
			CALCULATE(
			    COUNTROWS(FATO_VOO),
			    FATO_VOO[chegada_disponivel] = TRUE()
			)
		formatString: #,0
		displayFolder: Qualidade dos dados
		lineageTag: 64bc9ef7-e415-4d69-8655-5c3c9f4d2c3f

	/// CORRIGIDO nesta rodada: exige chegada_disponivel explícito antes de negar a flag de erro -- sem isso, confunde 'fora do limite' com 'sem dado' (armadilha de De Morgan, §13.3).
	measure 'Lc (Chegada Dentro do Limite)' =
			CALCULATE(
			    COUNTROWS(FATO_VOO),
			    FATO_VOO[chegada_disponivel] = TRUE(),
			    FATO_VOO[problema_atraso_chegada_acima_do_limite] = FALSE()
			)
		formatString: #,0
		displayFolder: Qualidade dos dados
		lineageTag: 683324e3-e941-42c7-a9f4-5c5ffed3748c

	/// CORRIGIDO nesta rodada: exige chegada_disponivel E partida_disponivel antes de negar a flag de erro (mesma armadilha de Lc).
	measure 'K (Coerência Cronológica)' =
			CALCULATE(
			    COUNTROWS(FATO_VOO),
			    FATO_VOO[chegada_disponivel] = TRUE(),
			    FATO_VOO[partida_disponivel] = TRUE(),
			    FATO_VOO[problema_chegada_anterior_a_partida] = FALSE()
			)
		formatString: #,0
		displayFolder: Qualidade dos dados
		lineageTag: e94a942e-3372-4cc4-9eb8-9fae10860040

	/// Interseção formal, já materializada -- usada para conferir Dc/Lc/K acima, não recalculada às cegas.
	measure 'Chegada Individualmente Válida (Dc ∩ Lc ∩ K)' =
			CALCULATE(
			    COUNTROWS(FATO_VOO),
			    FATO_VOO[chegada_individualmente_valida] = TRUE()
			)
		formatString: #,0
		displayFolder: Qualidade dos dados
		lineageTag: aca5f8e4-3144-4b9b-900b-4c556ed7f858

	/// R∩P∩Lp∩Dc∩Lc∩K -- base real do KPI7 (5.192.866).
	measure 'Atraso Chegada Válido (Elegibilidade Completa KPI7)' =
			CALCULATE(
			    COUNTROWS(FATO_VOO),
			    FATO_VOO[atraso_chegada_valido] = TRUE()
			)
		formatString: #,0
		displayFolder: Qualidade dos dados
		lineageTag: 050850c1-269c-4a03-bc10-23b982a76a30

	/// atraso_valido \ atraso_chegada_valido. Reconcilia com 146 (status_projeto.md).
	measure 'Conjunto 146 (Atraso Válido menos Atraso Chegada Válido)' =
			CALCULATE(
			    COUNTROWS(FATO_VOO),
			    FATO_VOO[atraso_valido] = TRUE(),
			    FATO_VOO[atraso_chegada_valido] = FALSE()
			)
		formatString: #,0
		displayFolder: Qualidade dos dados
		lineageTag: f8e5ddaa-1ce1-4528-ad07-4520d87cd2b7

	/// (R∩P) \ atraso_chegada_valido -- dinâmico nesta rodada (decisão 9). Reconcilia com 721.
	measure 'Conjunto 721 ((R∩P) menos Atraso Chegada Válido)' =
			CALCULATE(
			    COUNTROWS(FATO_VOO),
			    DIM_SITUACAO_VOO[situacao_voo] = "REALIZADO",
			    FATO_VOO[partida_disponivel] = TRUE(),
			    FATO_VOO[atraso_chegada_valido] = FALSE()
			)
		formatString: #,0
		displayFolder: Qualidade dos dados
		lineageTag: e49bf01d-8ea9-4440-b560-28a3316bb06b

	/// Esperado: 5.452.295 (mesmo n de data/processed/voos.parquet).
	measure 'Linhas Carregadas -- FATO_VOO' = COUNTROWS(FATO_VOO)
		formatString: #,0
		displayFolder: Homologação
		lineageTag: 37390dc9-0f61-453f-afa9-0f8b853bc8da

	/// Não é o instante do refresh do Power BI -- é a maior data_partida_prevista do universo usado na exportação Python (garante idempotência, ver 10_exportar_powerbi.py).
	measure 'Última Atualização (Data de Cálculo)' =
			VAR _linhas =
			    CALCULATETABLE(MET_UNIVERSO, MET_UNIVERSO[metrica] = "gini")
			VAR _n = COUNTROWS(_linhas)
			RETURN
			    IF(_n = 1, MAXX(_linhas, MET_UNIVERSO[data_calculo]))
		formatString: dd/mm/yyyy
		displayFolder: Homologação
		lineageTag: 11882de0-ae2e-41f6-a909-be2117bcdfdf

	/// Indicador textual de contexto não suportado para a página 00 — Homologação (Seção 11 da Rodada 7A).
	measure 'Aviso de Contexto -- Escopo Único (MET_*)' =
			VAR _anos = DISTINCTCOUNT(DIM_ANO[ano])
			VAR _operadoras = DISTINCTCOUNT(DIM_COMPANHIA[operadora_analitica])
			VAR _aeroportos = DISTINCTCOUNT(DIM_AEROPORTO[icao])
			VAR _segmentos = DISTINCTCOUNT(DIM_SEGMENTO[segmento_operacional])
			RETURN
			    IF(
			        _anos > 1 || _operadoras > 1 || _aeroportos > 1 || _segmentos > 1,
			        "Contexto não suportado: as tabelas MET_* só aceitam 1 valor por vez em cada dimensão de escopo (§11.1). Cartões de concentração podem mostrar (vazio).",
			        ""
			    )
		displayFolder: Homologação
		lineageTag: bf29a54d-e30a-4297-99e4-37b8afb38247

	/// Codigo ICAO bruto da fonte -- rastreabilidade.
	column sigla_icao_empresa
		dataType: string
		displayFolder: Identificação
		lineageTag: 70fcd156-4d9c-4f5d-bd2e-f5e86b4389d4
		summarizeBy: none
		sourceColumn: sigla_icao_empresa

	/// FK para DIM_CALENDARIO[data]. So a parte de data (sem hora) de partida_prevista.
	column data_partida_prevista
		dataType: dateTime
		formatString: dd/mm/yyyy
		displayFolder: Identificação
		lineageTag: 9fdaeaee-a6f6-4231-832a-858c8e98eda4
		summarizeBy: none
		sourceColumn: data_partida_prevista

	/// Drill-through pontual -- nao usar em medida agregada (alta cardinalidade).
	column numero_voo

/// Pontos da curva de Lorenz convencional (decisao 8) -- ordem crescente de impacto, mesma populacao do Gini. Tabela DESCONECTADA -- 101 linhas, escopo universo.
table FATO_CURVA_LORENZ
	lineageTag: aa130599-2f4e-4925-b3c0-f5c378ebcd84

	/// Curva de Lorenz CONVENCIONAL (ordem crescente, decisão 8) -- não confundir com ICA5 (ordem decrescente). Usar com percentil_voos no eixo X.
	measure '% Acumulado de Impacto (Curva de Lorenz)' =
			VAR _linhas =
			    CALCULATETABLE(
			        FATO_CURVA_LORENZ,
			        FATO_CURVA_LORENZ[escopo] = "universo"
			    )
			VAR _n = COUNTROWS(_linhas)
			RETURN
			    IF(_n = 1, MAXX(_linhas, FATO_CURVA_LORENZ[percentual_impacto_acumulado]))
		formatString: 0.00\%
		displayFolder: Concentração
		lineageTag: 658e1711-11f2-41f4-8375-d23e83f652ab

	/// Linha de referencia y=x da curva de Lorenz -- distribuicao perfeitamente uniforme (nenhuma concentracao). Usar SOMENTE no grafico da curva de Lorenz, nunca fora dele.
	measure 'Linha de Igualdade %' =
			MAX(FATO_CURVA_LORENZ[percentil_voos])
		formatString: 0.00\%
		displayFolder: Apresentação (curva de Lorenz)
		lineageTag: 52f51588-98c3-41cb-9da4-cab2e8648640

	/// So 'universo' na v1. Tabela DESCONECTADA.
	column escopo
		dataType: string
		lineageTag: 285b1d37-f2d2-4429-8df0-f4592721d189
		summarizeBy: none
		sourceColumn: escopo

	/// Eixo X -- ordem CRESCENTE de impacto (NAO reusa a ordenacao decrescente do ICA5).
	column percentil_voos
		dataType: double
		formatString: #,0.00
		lineageTag: 919fa990-5311-44c5-9634-1acf36ff4342
		summarizeBy: none
		sourceColumn: percentil_voos

	/// Eixo Y -- monotonico nao decrescente, (0,0) a (100,100) por construcao.
	column percentual_impacto_acumulado
		dataType: double
		formatString: #,0.00
		lineageTag: dc310442-a2ef-4821-924c-ec4c392a8a8f
		summarizeBy: none
		sourceColumn: percentual_impacto_acumulado

	column data_calculo
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: bed6e66f-3418-4d5e-a428-ca1c365decbe
		summarizeBy: none
		sourceColumn: data_calculo

	partition FATO_CURVA_LORENZ = m
		mode: import
		source =
				let
				    Origem = Parquet.Document(File.Contents(pPowerBIDataRoot & "\FATO_CURVA_LORENZ.parquet")),
				    #"Tipos Alterados" = Table.TransformColumnTypes(Origem, {{"escopo", type text}, {"percentil_voos", type number}, {"percentual_impacto_acumulado", type number}, {"data_calculo", type datetime}})
				in
				    #"Tipos Alterados"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation


/// Referencia pre-agregada de ICA5/Gini/top-shares por ano e tipo de periodo (ano_fechado/ytd). FK para DIM_ANO.
table MET_ANO
	lineageTag: 56098de3-9108-4e3b-8aed-caf34379a6b3

	/// ICA5 -- 5% de voos com maior impacto / impacto total (indicador AUTORAL, não é métrica ANAC nem padrão de mercado). Padrão COUNTROWS-guardado (§11.2) -- nunca SELECTEDVALUE(valor) sozinho.
	measure 'ICA5 % -- Ano Fechado' =
			VAR _linhas =
			    CALCULATETABLE(
			        MET_ANO,
			        MET_ANO[metrica] = "ica5_pct",
			        MET_ANO[tipo_periodo] = "ano_fechado"
			    )
			VAR _n = COUNTROWS(_linhas)
			RETURN
			    IF(_n = 1, MAXX(_linhas, MET_ANO[valor]))
		formatString: 0.00\%
		displayFolder: Concentração
		lineageTag: 55cd5092-d91c-4075-b6e3-1abf371153e1


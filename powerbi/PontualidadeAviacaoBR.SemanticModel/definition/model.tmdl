annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["DevMode","DaxQueryView_Desktop"]

annotation PBI_QueryOrder = ["AUDITORIA_DESCRICAO_AEROPORTO","DIM_AEROPORTO","DIM_ANO","DIM_CALENDARIO","DIM_CATEGORIA_ATRASO","DIM_COMPANHIA","DIM_FAIXA_HORARIA","DIM_MOTIVO_INVALIDEZ_CHEGADA","DIM_SEGMENTO","DIM_SITUACAO_VOO","FATO_CELULA_P11","FATO_CURVA_LORENZ","FATO_VOO","MET_AEROPORTO","MET_ANO","MET_H2_VARIANCIA","MET_OPERADORA","MET_SEGMENTO","MET_UNIVERSO","_HOMOLOGACAO_PYTHON","pPowerBIDataRoot"]

ref table AUDITORIA_DESCRICAO_AEROPORTO
